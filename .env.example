# 复制成 .env 后填写。两个 key 填一个就行；都填时默认用 DeepSeek，可以用 XG_PROVIDER 指定。
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# 可选
# XG_PROVIDER=deepseek              # deepseek 或 openrouter
# DEEPSEEK_MODEL=deepseek-chat      # 也可以用 deepseek-reasoner（更慢但更会推理）
# OPENROUTER_MODEL=deepseek/deepseek-chat   # OpenRouter 上任意模型 id，例如 anthropic/claude-opus-4.5
# XG_DEMO=1                         # 强制使用随机示例数据
